# Only the application and locked dependency metadata enter the build context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!apollo_rag/
!apollo_rag/**

# Keep generated files and private artifacts out even inside the app directory.
**/__pycache__
**/*.py[cod]
**/.git
**/.venv
**/.cache
**/.pytest_cache
**/*.egg-info
**/tests
**/docs
**/data
**/private
**/corpus
**/bundles
**/indexes
**/models
**/tokenizers
**/artifacts
**/chroma
**/chroma_db
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.bak
**/*.backup
**/*.pt
**/*.pth
**/*.bin
**/*.safetensors
**/*.onnx
**/*.pdf
**/*.txt
**/*.tar
**/*.tar.gz
**/*.zip
**/.env*
**/*.jsonl
**/manifest.json
**/sample_passages.md
